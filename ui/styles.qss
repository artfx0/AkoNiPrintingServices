/* =====================================================================
   AkoNi Printing Services — Modern SaaS Theme (Rhombus reference style)
   Applied globally via app.setStyleSheet() in main.py.

   Palette
   -------
   Background Canvas .... #F8FAFC     Surface / Cards ...... #FFFFFF
   Border / Divider ..... #E2E8F0     Muted Border ......... #F1F5F9
   Brand Accent (Gold) .. #D4AF37     Gold Dark / Amber .... #B45309
   Pill Tint (Gold) ..... #FEF3C7     Text Primary ......... #0F172A
   Text Secondary ....... #475569     Text Muted ........... #94A3B8
   Success / Positive ... #16A34A     Danger / Red ......... #EF4444
   Info / Blue .......... #3B82F6     Purple ............... #8B5CF6
   ===================================================================== */

/* ------------------------------ Global ------------------------------ */
QWidget {
    font-family: "Segoe UI", -apple-system, BlinkMacSystemFont, "Inter", "Roboto", sans-serif;
    font-size: 13px;
    color: #1E293B;
    background-color: #F8FAFC;
}

QLabel {
    background-color: transparent;
}

QMainWindow, QDialog {
    background-color: #F8FAFC;
}

QToolTip {
    background-color: #0F172A;
    color: #F8FAFC;
    border: 1px solid #334155;
    border-radius: 4px;
    padding: 4px 8px;
    font-size: 12px;
}

/* -------------------------- App Header Bar -------------------------- */
QFrame#AppHeader {
    background-color: #FFFFFF;
    border-bottom: 1px solid #E2E8F0;
}

QLineEdit#GlobalSearchBar {
    background-color: #F8FAFC;
    color: #0F172A;
    border: 1px solid #E2E8F0;
    border-radius: 8px;
    padding: 7px 14px;
    font-size: 13px;
}

QLineEdit#GlobalSearchBar:focus {
    border: 1.5px solid #CBD5E1;
    background-color: #FFFFFF;
}

QPushButton#HeaderIconBtn {
    background-color: #F8FAFC;
    color: #475569;
    border: 1px solid #E2E8F0;
    border-radius: 18px;
    font-size: 14px;
    padding: 0px;
}

QPushButton#HeaderIconBtn:hover {
    background-color: #F1F5F9;
    color: #0F172A;
    border-color: #CBD5E1;
}

QFrame#HeaderDivider {
    background-color: #E2E8F0;
}

QLabel#UserAvatar {
    background-color: #D4AF37;
    color: #FFFFFF;
    border-radius: 18px;
    font-weight: bold;
    font-size: 12px;
}

QLabel#HeaderUserName {
    font-size: 13px;
    font-weight: 600;
    color: #0F172A;
}

QLabel#HeaderUserRole {
    font-size: 11px;
    color: #64748B;
    font-weight: 500;
}

QPushButton#LogoutBtn {
    background-color: transparent;
    color: #64748B;
    border: 1px solid #E2E8F0;
    border-radius: 6px;
    padding: 5px 12px;
    font-size: 12px;
    font-weight: 500;
}

QPushButton#LogoutBtn:hover {
    background-color: #FEE2E2;
    color: #DC2626;
    border-color: #FCA5A5;
}

/* -------------------------- Left Sidebar ---------------------------- */
QFrame#SidebarContainer {
    background-color: #FFFFFF;
    border-right: 1px solid #E2E8F0;
}

QLabel#BrandLogoIcon {
    background-color: #FEF3C7;
    border-radius: 8px;
    font-size: 18px;
}

QLabel#BrandTitle {
    font-size: 17px;
    font-weight: bold;
    color: #0F172A;
}

QLabel#BrandSub {
    font-size: 11px;
    color: #64748B;
    font-weight: 500;
}

QFrame#SidebarDivider {
    background-color: #E2E8F0;
}

QListWidget#NavList {
    background-color: transparent;
    color: #475569;
    border: none;
    outline: 0;
    padding: 6px 0px;
}

QListWidget#NavList::item {
    background-color: transparent;
    color: #475569;
    padding: 10px 14px;
    margin: 2px 6px;
    border-radius: 8px;
    border-left: 3px solid transparent;
    font-size: 13px;
    font-weight: 500;
}

QListWidget#NavList::item:hover {
    background-color: #F1F5F9;
    color: #0F172A;
}

QListWidget#NavList::item:selected {
    background-color: #FEF3C7;
    color: #92400E;
    font-weight: 600;
    border: none;
    border-radius: 8px;
}

QLabel#SidebarFooter {
    font-size: 10px;
    color: #94A3B8;
    line-height: 14px;
}

/* ----------------------- Dashboard Content -------------------------- */
QScrollArea#DashboardScrollArea {
    background-color: #F8FAFC;
    border: none;
}

QWidget#DashboardContent {
    background-color: #F8FAFC;
}

QLabel#DashboardGreetingTitle {
    font-size: 24px;
    font-weight: bold;
    color: #0F172A;
}

QLabel#DashboardGreetingSub {
    font-size: 13px;
    color: #64748B;
}

QComboBox#DashboardDateFilter {
    background-color: #FFFFFF;
    color: #334155;
    border: 1px solid #E2E8F0;
    border-radius: 8px;
    padding: 6px 14px;
    font-size: 12px;
    font-weight: 500;
}

QPushButton#DashboardRefreshBtn {
    background-color: #FFFFFF;
    color: #334155;
    border: 1px solid #E2E8F0;
    border-radius: 8px;
    padding: 6px 14px;
    font-size: 12px;
    font-weight: 500;
}

QPushButton#DashboardRefreshBtn:hover {
    background-color: #F1F5F9;
    border-color: #CBD5E1;
}

/* ----------------------------- KPI Cards ---------------------------- */
QFrame#KpiCard {
    background-color: #FFFFFF;
    border: 1px solid #E2E8F0;
    border-radius: 12px;
}

QFrame#KpiCard:hover {
    border-color: #CBD5E1;
    background-color: #F8FAFC;
}

QFrame#KpiCard[alert="true"] {
    border: 2px solid #EF4444;
}

QFrame#KpiCard[alert="true"]:hover {
    border: 2px solid #DC2626;
    background-color: #FEF2F2;
}

QLabel#KpiTitle {
    color: #64748B;
    font-size: 13px;
    font-weight: 500;
    background-color: transparent;
}

QLabel#KpiValue {
    color: #0F172A;
    font-size: 26px;
    font-weight: bold;
    background-color: transparent;
}

QLabel#KpiSubtitle {
    font-size: 12px;
    background-color: transparent;
}

QLabel#KpiSubtitle[tone="positive"] { color: #16A34A; font-weight: 600; }
QLabel#KpiSubtitle[tone="negative"] { color: #EF4444; font-weight: 600; }
QLabel#KpiSubtitle[tone="neutral"]  { color: #64748B; font-weight: 500; }

QLabel#KpiIconBadge {
    border-radius: 8px;
    font-size: 16px;
}

QLabel#KpiIconBadge[theme="gold"] {
    background-color: #FEF3C7;
    color: #B45309;
}

QLabel#KpiIconBadge[theme="coral"] {
    background-color: #FEE2E2;
    color: #DC2626;
}

QLabel#KpiIconBadge[theme="blue"] {
    background-color: #DBEAFE;
    color: #2563EB;
}

QLabel#KpiIconBadge[theme="amber"] {
    background-color: #FEF9C3;
    color: #CA8A04;
}

QLabel#KpiIconBadge[theme="green"] {
    background-color: #DCFCE7;
    color: #16A34A;
}

/* ----------------------- 2x2 Dashboard Panels ----------------------- */
QFrame#DashboardPanel {
    background-color: #FFFFFF;
    border: 1px solid #E2E8F0;
    border-radius: 12px;
}

QLabel#PanelTitle {
    font-size: 15px;
    font-weight: bold;
    color: #0F172A;
}

QPushButton#PanelLinkBtn {
    background-color: transparent;
    color: #B45309;
    border: none;
    font-size: 12px;
    font-weight: 600;
    padding: 2px 4px;
}

QPushButton#PanelLinkBtn:hover {
    color: #92400E;
    text-decoration: underline;
}

QWidget#PanelBody {
    background-color: transparent;
}

QFrame#DashboardListItem {
    background-color: #F8FAFC;
    border: 1px solid #F1F5F9;
    border-radius: 8px;
}

QFrame#DashboardListItem:hover {
    background-color: #F1F5F9;
    border-color: #E2E8F0;
}

QLabel#OrderBadgeIcon {
    background-color: #E0F2FE;
    border-radius: 18px;
    font-size: 16px;
}

QLabel#MaterialBadgeIcon {
    background-color: #FEF3C7;
    border-radius: 18px;
    font-size: 16px;
}

QLabel#MaterialBadgeIcon[alert="true"] {
    background-color: #FEE2E2;
}

QLabel#StatusPill {
    font-size: 11px;
    font-weight: 600;
    border-radius: 10px;
    padding: 3px 8px;
}

QLabel#StatusPill[status="completed"], QLabel#StatusPill[status="paid"] {
    background-color: #DCFCE7;
    color: #15803D;
}

QLabel#StatusPill[status="pending"] {
    background-color: #FEF3C7;
    color: #B45309;
}

QLabel#StatusPill[status="processing"], QLabel#StatusPill[status="in progress"], QLabel#StatusPill[status="verified"] {
    background-color: #DBEAFE;
    color: #1D4ED8;
}

QLabel#StatusPill[status="ready"], QLabel#StatusPill[status="refunded"] {
    background-color: #F3E8FF;
    color: #7E22CE;
}

QLabel#StatusPill[status="delivered"] {
    background-color: #CCFBF1;
    color: #0F766E;
}

QLabel#StatusPill[status="cancelled"], QLabel#StatusPill[status="failed"] {
    background-color: #FEE2E2;
    color: #DC2626;
}

QLabel#StatusPill[status="other"] {
    background-color: #F1F5F9;
    color: #475569;
}

QLabel#StatusPill[status="sales"] {
    background-color: #FEF3C7;
    color: #92400E;
}

QLabel#StatusPill[status="materials"] {
    background-color: #DCFCE7;
    color: #15803D;
}

QLabel#StatusPill[status="labor"] {
    background-color: #DBEAFE;
    color: #1D4ED8;
}

QLabel#StatusPill[status="miscellaneous"] {
    background-color: #F3E8FF;
    color: #7E22CE;
}

QLabel#StatusPill[status="utility"] {
    background-color: #FFEDD5;
    color: #C2410C;
}

QLabel#StockPill {
    font-size: 11px;
    font-weight: 600;
    border-radius: 10px;
    padding: 3px 8px;
}

QLabel#StockPill[alert="false"] {
    background-color: #DCFCE7;
    color: #15803D;
}

QLabel#StockPill[alert="true"] {
    background-color: #FEE2E2;
    color: #DC2626;
}

/* -------------------------- Module Headers -------------------------- */
QLabel#ModuleHeaderTitle {
    font-size: 20px;
    font-weight: bold;
    color: #0F172A;
}

QLabel#ModuleHeaderSub {
    font-size: 13px;
    color: #64748B;
}

QFrame#ModuleCardContainer {
    background-color: #FFFFFF;
    border: 1px solid #E2E8F0;
    border-radius: 12px;
}

QFrame#SummaryBox {
    background-color: #F8FAFC;
    border: 1px solid #E2E8F0;
    border-radius: 10px;
}

/* ------------------------------ Buttons ----------------------------- */
QPushButton {
    background-color: #D4AF37;
    color: #0F172A;
    font-weight: 600;
    font-size: 12px;
    border: none;
    border-radius: 6px;
    padding: 7px 14px;
}

QPushButton:hover {
    background-color: #C59B27;
}

QPushButton:pressed {
    background-color: #B58900;
}

QPushButton:disabled {
    background-color: #E2E8F0;
    color: #94A3B8;
}

QPushButton#SecondaryBtn {
    background-color: #FFFFFF;
    color: #334155;
    border: 1px solid #CBD5E1;
    font-weight: 500;
    font-size: 12px;
    border-radius: 6px;
    padding: 7px 11px;
}

QPushButton#SecondaryBtn:hover {
    background-color: #F8FAFC;
    color: #0F172A;
    border-color: #94A3B8;
}

QPushButton#SecondaryBtn:pressed {
    background-color: #F1F5F9;
}

QPushButton#DangerBtn {
    background-color: #FFFFFF;
    color: #DC2626;
    border: 1px solid #FCA5A5;
    font-weight: 500;
    font-size: 12px;
    border-radius: 6px;
    padding: 7px 11px;
}

QPushButton#DangerBtn:hover {
    background-color: #FEE2E2;
    border-color: #F87171;
}

QPushButton#DangerBtn:pressed {
    background-color: #FECACA;
}

/* -------------------------- Inputs & Forms -------------------------- */
QLineEdit#TableSearchInput {
    background-color: #FFFFFF;
    color: #0F172A;
    border: 1px solid #CBD5E1;
    border-radius: 8px;
    padding: 7px 12px;
    font-size: 13px;
}

QLineEdit#TableSearchInput:focus {
    border: 1.5px solid #D4AF37;
}

QLineEdit#CustomerFormInput {
    background-color: #F8FAFC;
    color: #0F172A;
    border: 1px solid #CBD5E1;
    border-radius: 8px;
    padding: 7px 12px;
    font-size: 13px;
}

QLineEdit#CustomerFormInput:focus {
    border: 1.5px solid #D4AF37;
    background-color: #FFFFFF;
}

QComboBox#TableFilterCombo {
    background-color: #FFFFFF;
    color: #334155;
    border: 1px solid #CBD5E1;
    border-radius: 8px;
    padding: 6px 12px;
    font-size: 12px;
    font-weight: 500;
}

QComboBox#TableFilterCombo:focus {
    border: 1.5px solid #D4AF37;
}

/* -------------------------- Inputs & Forms -------------------------- */
QLineEdit, QComboBox, QSpinBox, QDoubleSpinBox, QDateEdit, QTextEdit, QPlainTextEdit {
    background-color: #FFFFFF;
    color: #0F172A;
    border: 1px solid #E2E8F0;
    border-radius: 6px;
    padding: 6px 10px;
    selection-background-color: #FEF3C7;
    selection-color: #0F172A;
}

QLineEdit:focus, QComboBox:focus, QSpinBox:focus, QDoubleSpinBox:focus,
QDateEdit:focus, QTextEdit:focus, QPlainTextEdit:focus {
    border: 1px solid #D4AF37;
}

QLineEdit:read-only, QTextEdit:read-only, QPlainTextEdit:read-only {
    background-color: #F8FAFC;
    color: #475569;
    border: 1px solid #E2E8F0;
}

QComboBox::drop-down {
    border: none;
    width: 20px;
}

QComboBox QAbstractItemView {
    background-color: #FFFFFF;
    color: #0F172A;
    border: 1px solid #E2E8F0;
    selection-background-color: #FEF3C7;
    selection-color: #92400E;
}

/* ------------------------------ Tables ------------------------------ */
QTableWidget {
    background-color: #FFFFFF;
    alternate-background-color: #F8FAFC;
    color: #0F172A;
    gridline-color: #F1F5F9;
    border: 1px solid #E2E8F0;
    border-radius: 8px;
    selection-background-color: #FEF3C7;
    selection-color: #92400E;
}

QTableWidget::item {
    padding: 8px 10px;
    border-bottom: 1px solid #F1F5F9;
}

QTableWidget::item:selected {
    background-color: #FEF3C7;
    color: #92400E;
}

QHeaderView::section {
    background-color: #F8FAFC;
    color: #475569;
    font-weight: 600;
    border: none;
    border-bottom: 1px solid #E2E8F0;
    padding: 8px 10px;
}

/* ---------------------------- Tabs & Misc --------------------------- */
QTabWidget::pane {
    border: 1px solid #E2E8F0;
    background-color: #FFFFFF;
    border-radius: 12px;
}

QTabBar::tab {
    background-color: #F8FAFC;
    color: #64748B;
    border: 1px solid #E2E8F0;
    padding: 10px 20px;
    margin-right: 6px;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    font-weight: 500;
}

QTabBar::tab:selected {
    background-color: #FFFFFF;
    color: #0F172A;
    font-weight: 600;
    border-bottom: 2px solid #D4AF37;
}

QTabBar::tab:hover {
    background-color: #F1F5F9;
    color: #0F172A;
}

QCheckBox {
    spacing: 8px;
    color: #334155;
    font-size: 13px;
    background-color: transparent;
}

QCheckBox::indicator {
    width: 18px;
    height: 18px;
    border: 1px solid #CBD5E1;
    border-radius: 4px;
    background-color: #FFFFFF;
}

QCheckBox::indicator:hover {
    border-color: #D4AF37;
}

QCheckBox::indicator:checked {
    background-color: #D4AF37;
    border-color: #D4AF37;
}

/* --------------------------- Scrollbars ----------------------------- */
QScrollBar:vertical {
    border: none;
    background: #F1F5F9;
    width: 8px;
    border-radius: 4px;
    margin: 0px;
}

QScrollBar::handle:vertical {
    background: #CBD5E1;
    min-height: 24px;
    border-radius: 4px;
}

QScrollBar::handle:vertical:hover {
    background: #94A3B8;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}
